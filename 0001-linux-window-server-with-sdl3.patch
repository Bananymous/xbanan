+static Keymap s_sdl_keymap;
+
+static bool poll_sdl_events(Framebuffer& framebuffer, WindowServer& window_server)
+{
+	{
+		static float prev_x { 0 }, prev_y { 0 };
+
+		float curr_x, curr_y;
+		SDL_GetMouseState(&curr_x, &curr_y);
+
+		if (prev_x != curr_x || prev_y != curr_y)
+		{
+			int w, h;
+			SDL_GetWindowSize(framebuffer.window, &w, &h);
+
+			window_server.on_mouse_move_abs({
+				.abs_x = static_cast<int32_t>(curr_x),
+				.abs_y = static_cast<int32_t>(curr_y),
+				.min_x = 0,
+				.min_y = 0,
+				.max_x = w,
+				.max_y = h,
+			});
+		}
+
+		prev_x = curr_x;
+		prev_y = curr_y;
+	}
+
+	SDL_Event event;
+	while (SDL_PollEvent(&event))
+	{
+		switch (event.type)
+		{
+			case SDL_EVENT_QUIT:
+				return true;
+			case SDL_EVENT_KEY_DOWN:
+			case SDL_EVENT_KEY_UP:
+			{
+				struct sdl_gui_mod_pair {
+					SDL_Keymod                   sdl_mod;
+					LibInput::KeyEvent::Modifier gui_mod;
+				};
+				constexpr sdl_gui_mod_pair mod_map[] {
+					{ SDL_KMOD_LSHIFT, LibInput::KeyEvent::Modifier::LShift     },
+					{ SDL_KMOD_RSHIFT, LibInput::KeyEvent::Modifier::RShift     },
+					{ SDL_KMOD_LEVEL5, LibInput::KeyEvent::Modifier::RAlt       },
+					{ SDL_KMOD_LCTRL,  LibInput::KeyEvent::Modifier::LCtrl      },
+					{ SDL_KMOD_RCTRL,  LibInput::KeyEvent::Modifier::RCtrl      },
+					{ SDL_KMOD_RALT,   LibInput::KeyEvent::Modifier::RAlt       },
+					{ SDL_KMOD_LALT,   LibInput::KeyEvent::Modifier::LAlt       },
+					{ SDL_KMOD_LGUI,   LibInput::KeyEvent::Modifier::LSuper     },
+					{ SDL_KMOD_RGUI,   LibInput::KeyEvent::Modifier::RSuper     },
+					{ SDL_KMOD_NUM,    LibInput::KeyEvent::Modifier::NumLock    },
+					{ SDL_KMOD_SCROLL, LibInput::KeyEvent::Modifier::ScrollLock },
+					{ SDL_KMOD_CAPS,   LibInput::KeyEvent::Modifier::CapsLock   },
+				};
+
+				uint16_t modifier = 0;
+				for (const auto [sdl_mod, gui_mod] : mod_map)
+					if (event.key.mod & sdl_mod)
+						modifier |= gui_mod;
+				if (event.key.down)
+					modifier |= LibInput::KeyEvent::Modifier::Pressed;
+
+				window_server.on_key_event(LibInput::KeyboardLayout::get().key_event_from_raw({
+					.modifier = modifier,
+					.keycode = s_sdl_keymap.map[event.key.scancode],
+				}));
+
+				break;
+			}
+			case SDL_EVENT_MOUSE_BUTTON_DOWN:
+			case SDL_EVENT_MOUSE_BUTTON_UP:
+			{
+				constexpr LibInput::MouseButton button_map[] {
+					[0]                 = LibInput::MouseButton::Left,
+					[SDL_BUTTON_LEFT]   = LibInput::MouseButton::Left,
+					[SDL_BUTTON_MIDDLE] = LibInput::MouseButton::Middle,
+					[SDL_BUTTON_RIGHT]  = LibInput::MouseButton::Right,
+					[SDL_BUTTON_X1]     = LibInput::MouseButton::Extra1,
+					[SDL_BUTTON_X2]     = LibInput::MouseButton::Extra2,
+				};
+				window_server.on_mouse_button({
+					.button = button_map[event.button.button],
+					.pressed = event.button.down,
+				});
+				break;
+			}
+			case SDL_EVENT_MOUSE_WHEEL:
+				window_server.on_mouse_scroll({
+					.scroll = static_cast<int32_t>(event.wheel.y),
+				});
+				break;
+		}
+	}
+
+	return false;
+}
